rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // ASTRO-006: Field-level schema validation for user root document
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'gender', 'birthYear', 'heightCm', 'weightKg',
          'activityLevel', 'dailyTargetCalories', 'isOnboardingCompleted',
          'targetWeightKg', 'fitnessGoal',
          'healthConnected', 'healthKitConnected', 'healthLastSync',
          'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt',
          'fcmToken', 'astroId'
        ])
        && (!request.resource.data.keys().hasAny(['dailyTargetCalories']) || (request.resource.data.dailyTargetCalories is int && request.resource.data.dailyTargetCalories >= 500 && request.resource.data.dailyTargetCalories <= 15000))
        && (!request.resource.data.keys().hasAny(['heightCm']) || (request.resource.data.heightCm is number && request.resource.data.heightCm > 0 && request.resource.data.heightCm < 300))
        && (!request.resource.data.keys().hasAny(['weightKg']) || (request.resource.data.weightKg is number && request.resource.data.weightKg > 0 && request.resource.data.weightKg < 500));

      // User personal subcollections
      match /foodLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /water_logs/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /recipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meal_plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /chat_sessions/{sessionId}/{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /gamification/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /aiUsage/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow create only if initializing scanCount to 1
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.scanCount == 1;
        // Allow update only if incrementing scanCount by exactly 1
        // and scanCount has not exceeded the daily limit (10)
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.scanCount == resource.data.scanCount + 1
                      && request.resource.data.scanCount <= 10;
      }

      // ASTRO-021: Streak Nudge subcollection for user
      match /nudges/{nudgeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ASTRO-020 & ASTRO-021: Global Social Leaderboard & Nudges
    match /social_leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /nudges/{senderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == senderId;
      }

      match /friends/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ASTRO-022: Planetary Challenges & Guilds
    match /guilds/{guildId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.member_ids ||
        request.auth.uid in request.resource.data.member_ids ||
        resource.data.owner_id == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.owner_id == request.auth.uid;

      match /nudges/{nudgeId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
