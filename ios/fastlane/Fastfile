# ios/fastlane/Fastfile
# AstroBite iOS Fastlane Pipeline

default_platform(:ios)

platform :ios do
  project_root = File.expand_path("../..", __dir__)

  desc "Build iOS IPA / Archive in release mode"
  lane :build_ipa do
    UI.message("🚀 Building iOS IPA in release mode...")
    Dir.chdir(project_root) do
      if ENV["NO_CODESIGN"] == "true" || (ENV["CI"] && (ENV["APPLE_CERTIFICATE_KEY_P12"].nil? || ENV["APPLE_CERTIFICATE_KEY_P12"].strip.empty?))
        UI.important("⚠️ Building with --no-codesign (Unsigned CI build)...")
        sh("flutter", "build", "ipa", "--release", "--no-codesign")
      else
        sh("flutter", "build", "ipa", "--release")
      end
    end
    UI.success("✅ iOS Release build completed in build/ios/!")
  end

  desc "Build iOS Release"
  lane :build_release do
    build_ipa
  end

  desc "Upload to Apple TestFlight"
  lane :deploy_testflight do
    build_ipa
    UI.message("📦 Uploading IPA to Apple TestFlight...")
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
    UI.success("✅ Uploaded to TestFlight!")
  end

  desc "Distribute iOS IPA to Firebase App Distribution for Testers"
  lane :distribute_firebase do
    build_ipa
    ipa_file = Dir.glob(File.join(project_root, "build/ios/ipa/*.ipa")).first
    UI.user_error!("No IPA file found in build/ios/ipa/!") unless ipa_file

    UI.message("📦 Uploading IPA to Firebase App Distribution...")
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_IOS"] || "1:925552313324:ios:d8bb8269224dff455d36c9",
      ipa_path: ipa_file,
      groups: ENV["FIREBASE_TESTER_GROUPS"] || "internal-testers",
      release_notes: ENV["RELEASE_NOTES"] || "AstroBite automated iOS release build",
      service_credentials_file: ENV["FIREBASE_CREDENTIALS_PATH"]
    )
    UI.success("🎉 iOS IPA distributed to Firebase Testers successfully!")
  end
end
